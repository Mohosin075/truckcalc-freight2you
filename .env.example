NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/truckcalc
IP_ADDRESS=127.0.0.1
PORT=5000
CLIENT_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRE_IN=10d
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=180d
JWT_REFRESH_EXPIRE_LONG=365d
TEMP_JWT_SECRET=your-temp-jwt-secret
TEMP_JWT_EXPIRE_IN=1h

# Email
EMAIL_FROM=your-email@example.com
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_PORT=587
EMAIL_HOST=smtp.example.com
RESEND_API_KEY=your-resend-api-key

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET=your-cloudinary-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_BUCKET_NAME=your-aws-bucket-name

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback


# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_WEB_HOOK_SECRET=your-agora-webhook-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key


# Others
SERVER_MAP_API_KEY=your-google-maps-api-key
APPLICATION_FEE=0
INSTANT_TRANSFER_FEE=0
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin-password
